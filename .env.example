PORT=3000
NODE_ENV=development
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHAR_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SET_A_LONG_UNIQUE_PASSWORD
DATABASE_FILE=./db/rahul-mart.sqlite
# For first-run, the Windows starter script generates a private .env file.
# Do not use this example file as live credentials.
# Production (set these in your host's dashboard, not in a file):
# NODE_ENV=production
# DATABASE_FILE=/data/rahul-mart.sqlite
